# Environment Configuration Template
# Duplicate this file to .env for local development

PORT=3000

# Secret key used for signing JWT tokens (use a long random string in production)
JWT_SECRET=flowexpense_super_secure_jwt_secret_key_2026

# MongoDB Atlas Connection String
# Leave empty for local file database mode, or paste your MongoDB Atlas URI here:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/flowexpense?retryWrites=true&w=majority
MONGODB_URI=
